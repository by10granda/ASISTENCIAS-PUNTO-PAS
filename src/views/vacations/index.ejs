<%- include('../partials/header') %>
<%- include('../partials/errors') %>

<section class="panel">
  <div class="section-title">
    <h2>Saldo de vacaciones al <%= balanceDate %></h2>
    <p>15 dias calendario por cada ano cumplido desde la fecha de ingreso.</p>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Trabajador</th><th>Ingreso</th><th>Anos cumplidos</th><th>Generados</th><th>Usados/programados</th><th>Dias dados de baja</th><th>Disponibles</th></tr></thead>
      <tbody>
        <% if (!balances.length) { %><tr><td colspan="7" class="empty">No hay trabajadores registrados.</td></tr><% } %>
        <% balances.forEach((b) => { %><tr><td><%= b.full_name %></td><td><%= b.hire_date %></td><td><%= b.completed_years %></td><td><%= b.earned_days %></td><td><%= b.used_days %></td><td><%= b.written_off_days %></td><td><strong class="<%= b.available_days < 0 ? 'text-danger' : '' %>"><%= b.available_days %></strong></td></tr><% }) %>
      </tbody>
    </table>
  </div>
</section>

<section class="panel">
  <h2>Registrar vacaciones</h2>
  <form method="post" action="/vacaciones" class="form-grid confirm-important">
    <label>Trabajador<select required name="worker_id"><option value="">Seleccione</option><% workers.forEach((w) => { %><option value="<%= w.id %>"><%= w.full_name %></option><% }) %></select></label>
    <label>Inicio<input required type="date" name="start_date"></label>
    <label>Finalizacion<input required type="date" name="end_date"></label>
    <label>Estado<select name="status"><option>Programadas</option><option>En curso</option><option>Finalizadas</option></select></label>
    <label class="span-2">Observacion<textarea name="observation" rows="3"></textarea></label>
    <div class="actions"><button>Guardar vacaciones</button></div>
  </form>
</section>

<section class="panel danger-zone">
  <h2>Dar de baja dias acumulados</h2>
  <p>Este movimiento descuenta dias del saldo disponible y queda registrado en el historial.</p>
  <form method="post" action="/vacaciones/bajas" class="form-grid confirm-important">
    <label>Trabajador<select required name="worker_id"><option value="">Seleccione</option><% workers.forEach((w) => { %><option value="<%= w.id %>"><%= w.full_name %></option><% }) %></select></label>
    <label>Cantidad de dias<input required type="number" name="days" min="1" step="1"></label>
    <label>Fecha de la baja<input required type="date" name="record_date" max="<%= balanceDate %>" value="<%= balanceDate %>"></label>
    <label>Responsable<input required name="registered_by" value="Administrador"></label>
    <label class="span-2">Motivo<textarea required name="reason" rows="3"></textarea></label>
    <div class="actions"><button class="danger-button">Registrar baja</button></div>
  </form>
</section>

<section class="panel">
  <h2>Historial de vacaciones</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Trabajador</th><th>Inicio</th><th>Fin</th><th>Dias</th><th>Estado</th><th>Observacion</th></tr></thead>
      <tbody>
        <% if (!vacations.length) { %><tr><td colspan="6" class="empty">No hay vacaciones registradas.</td></tr><% } %>
        <% vacations.forEach((v) => { %><tr><td><%= v.full_name %></td><td><%= v.start_date %></td><td><%= v.end_date %></td><td><%= v.total_days %></td><td><span class="pill"><%= v.status %></span></td><td><%= v.observation || '-' %></td></tr><% }) %>
      </tbody>
    </table>
  </div>
</section>

<section class="panel">
  <h2>Historial de dias dados de baja</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Fecha</th><th>Trabajador</th><th>Dias</th><th>Motivo</th><th>Responsable</th></tr></thead>
      <tbody>
        <% if (!deductions.length) { %><tr><td colspan="5" class="empty">No hay bajas registradas.</td></tr><% } %>
        <% deductions.forEach((d) => { %><tr><td><%= d.record_date %></td><td><%= d.full_name %></td><td><%= d.days %></td><td><%= d.reason %></td><td><%= d.registered_by %></td></tr><% }) %>
      </tbody>
    </table>
  </div>
</section>

<%- include('../partials/footer') %>
