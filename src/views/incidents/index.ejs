<%- include('../partials/header') %>
<%- include('../partials/errors') %>

<section class="panel">
  <div class="section-title">
    <div>
      <h2>Novedades</h2>
      <p>Viendo <strong>todas</strong> las sucursales.</p>
      <% if (typeof branch !== 'undefined' && branch) { %><p class="text-muted">Filtrado por <strong><%= branch %></strong>. <a href="/novedades">Quitar filtro</a></p><% } %>
    </div>
    <form class="inline-form" method="get">
      <select name="branch"><option value="">Todas las sucursales</option><% branches.forEach((name) => { %><option value="<%= name %>" <%= branch === name ? 'selected' : '' %>><%= name %></option><% }) %></select>
      <button>Aplicar</button>
    </form>
  </div>
</section>

<section class="panel">
  <div class="section-title">
    <div>
      <h2>Descargar novedades</h2>
      <p>Exporta llamados de atencion y abandonos de trabajo en un solo archivo.</p>
    </div>
    <div class="export-actions">
      <a class="button ghost" href="/novedades/excel<%= branch ? `?branch=${encodeURIComponent(branch)}` : '' %>">Descargar Excel</a>
      <a class="button ghost" href="/novedades/pdf<%= branch ? `?branch=${encodeURIComponent(branch)}` : '' %>">Descargar PDF</a>
    </div>
  </div>
</section>

<section class="panel">
  <h2>Registrar llamado de atencion</h2>
  <form method="post" action="/novedades/llamados" class="form-grid confirm-important">
    <label>Trabajador<select required name="worker_id"><option value="">Seleccione</option><% workers.forEach((w) => { %><option value="<%= w.id %>"><%= w.full_name %></option><% }) %></select></label>
    <label>Fecha<input required type="date" name="record_date" value="<%= today %>"></label>
    <label>Usuario que registra<input required name="registered_by" value="Administrador"></label>
    <label>Motivo<input required name="reason" placeholder="Ej: Incumplimiento de horario"></label>
    <label class="span-2">Descripcion<textarea required name="description" rows="3" placeholder="Detalle del llamado de atencion"></textarea></label>
    <div class="actions"><button>Guardar llamado de atencion</button></div>
  </form>
</section>

<section class="panel">
  <h2>Registrar abandono de trabajo</h2>
  <form method="post" action="/novedades/abandonos" class="form-grid confirm-important">
    <label>Trabajador<select required name="worker_id"><option value="">Seleccione</option><% workers.forEach((w) => { %><option value="<%= w.id %>"><%= w.full_name %></option><% }) %></select></label>
    <label>Fecha<input required type="date" name="record_date" value="<%= today %>"></label>
    <label>Hora de salida, si aplica<input type="time" name="exit_time"></label>
    <label>Usuario que registra<input required name="registered_by" value="Administrador"></label>
    <label class="span-2">Motivo o detalle<textarea required name="reason" rows="3" placeholder="Detalle del abandono de trabajo"></textarea></label>
    <label class="span-2">Observacion<textarea name="observation" rows="3"></textarea></label>
    <div class="actions"><button>Guardar abandono de trabajo</button></div>
  </form>
</section>

<section class="panel">
  <h2>Registrar retiro por accidente laboral o enfermedad</h2>
  <form method="post" action="/novedades/retiros" class="form-grid confirm-important">
    <label>Trabajador<select required name="worker_id"><option value="">Seleccione</option><% workers.forEach((w) => { %><option value="<%= w.id %>"><%= w.full_name %></option><% }) %></select></label>
    <label>Fecha<input required type="date" name="record_date" value="<%= today %>"></label>
    <label>Hora de retiro, si aplica<input type="time" name="exit_time"></label>
    <label>Causa<select required name="cause"><option value="">Seleccione</option><option>Accidente laboral</option><option>Enfermedad</option></select></label>
    <label>Usuario que registra<input required name="registered_by" value="Administrador"></label>
    <label class="checkbox"><input type="checkbox" name="has_support_doc"> Tiene documento de respaldo</label>
    <label class="span-2">Detalle<textarea required name="description" rows="3" placeholder="Detalle del retiro del trabajador"></textarea></label>
    <div class="actions"><button>Guardar retiro</button></div>
  </form>
</section>

<section class="panel">
  <div class="section-title">
    <h2>Historial de faltas justificadas e injustificadas (con certificado)</h2>
    <div class="export-actions">
      <a class="button ghost" href="/novedades/excel?table=faltas<%= exportQuery ? '&' + exportQuery : '' %>">Descargar Excel</a>
      <a class="button ghost" href="/novedades/pdf?table=faltas<%= exportQuery ? '&' + exportQuery : '' %>">Descargar PDF</a>
    </div>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Fecha</th><th>Trabajador</th><th>Sucursal</th><th>Tipo</th><th>Motivo</th><th>Certificado</th><th>Usuario</th></tr></thead>
      <tbody>
        <% if (!absences.length) { %><tr><td colspan="7" class="empty">No hay faltas registradas.</td></tr><% } %>
        <% absences.forEach((record) => { %><tr>
          <td><%= record.record_date %></td>
          <td><%= record.full_name %></td>
          <td><%= record.branch || '-' %></td>
          <td><span class="pill <%= record.status === 'FALTA INJUSTIFICADA' ? 'danger' : 'success' %>"><%= record.status === 'FALTA JUSTIFICADA' ? 'Justificada' : 'Injustificada' %></span></td>
          <td><%= record.justified_reason || record.observation || '-' %></td>
          <td><% if (Number(record.has_support_doc)) { %><a href="/asistencia/certificado?worker_id=<%= record.worker_id %>&record_date=<%= record.record_date %>" target="_blank">Ver certificado</a><% } else { %><span class="pill">Sin documento</span><% } %></td>
          <td><%= record.registered_by || '-' %></td>
        </tr><% }) %>
      </tbody>
    </table>
  </div>
</section>

<section class="panel">
  <div class="section-title">
    <h2>Historial de llamados de atencion</h2>
    <div class="export-actions">
      <a class="button ghost" href="/novedades/excel?table=llamados<%= exportQuery ? '&' + exportQuery : '' %>">Descargar Excel</a>
      <a class="button ghost" href="/novedades/pdf?table=llamados<%= exportQuery ? '&' + exportQuery : '' %>">Descargar PDF</a>
    </div>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Fecha</th><th>Trabajador</th><th>Motivo</th><th>Descripcion</th><th>Usuario</th><th>Registrado</th></tr></thead>
      <tbody>
        <% if (!attentionCalls.length) { %><tr><td colspan="6" class="empty">No hay llamados de atencion registrados.</td></tr><% } %>
        <% attentionCalls.forEach((record) => { %><tr><td><%= record.record_date %></td><td><%= record.full_name %></td><td><%= record.reason %></td><td><%= record.description %></td><td><%= record.registered_by %></td><td><%= record.created_at %></td></tr><% }) %>
      </tbody>
    </table>
  </div>
</section>

<section class="panel">
  <div class="section-title">
    <h2>Historial de retiros por accidente laboral o enfermedad</h2>
    <div class="export-actions">
      <a class="button ghost" href="/novedades/excel?table=retiros<%= exportQuery ? '&' + exportQuery : '' %>">Descargar Excel</a>
      <a class="button ghost" href="/novedades/pdf?table=retiros<%= exportQuery ? '&' + exportQuery : '' %>">Descargar PDF</a>
    </div>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Fecha</th><th>Trabajador</th><th>Hora retiro</th><th>Causa</th><th>Detalle</th><th>Respaldo</th><th>Usuario</th><th>Registrado</th></tr></thead>
      <tbody>
        <% if (!medicalWithdrawals.length) { %><tr><td colspan="8" class="empty">No hay retiros registrados.</td></tr><% } %>
        <% medicalWithdrawals.forEach((record) => { %><tr><td><%= record.record_date %></td><td><%= record.full_name %></td><td><%= record.exit_time || '-' %></td><td><%= record.cause %></td><td><%= record.description %></td><td><%= Number(record.has_support_doc) ? 'Si' : 'No' %></td><td><%= record.registered_by %></td><td><%= record.created_at %></td></tr><% }) %>
      </tbody>
    </table>
  </div>
</section>

<section class="panel">
  <div class="section-title">
    <h2>Historial de abandonos de trabajo</h2>
    <div class="export-actions">
      <a class="button ghost" href="/novedades/excel?table=abandonos<%= exportQuery ? '&' + exportQuery : '' %>">Descargar Excel</a>
      <a class="button ghost" href="/novedades/pdf?table=abandonos<%= exportQuery ? '&' + exportQuery : '' %>">Descargar PDF</a>
    </div>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Fecha</th><th>Trabajador</th><th>Hora salida</th><th>Motivo</th><th>Observacion</th><th>Usuario</th><th>Registrado</th></tr></thead>
      <tbody>
        <% if (!jobAbandonments.length) { %><tr><td colspan="7" class="empty">No hay abandonos de trabajo registrados.</td></tr><% } %>
        <% jobAbandonments.forEach((record) => { %><tr><td><%= record.record_date %></td><td><%= record.full_name %></td><td><%= record.exit_time || '-' %></td><td><%= record.reason %></td><td><%= record.observation || '-' %></td><td><%= record.registered_by %></td><td><%= record.created_at %></td></tr><% }) %>
      </tbody>
    </table>
  </div>
</section>

<%- include('../partials/footer') %>
