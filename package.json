{
  "name": "control-asistencia-trabajadores",
  "version": "1.0.0",
  "description": "Sistema basico para control de asistencia de trabajadores.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --watch --experimental-sqlite --disable-warning=ExperimentalWarning src/server.js",
    "api": "node --experimental-sqlite --disable-warning=ExperimentalWarning src/apiServer.js",
    "api:dev": "node --watch --experimental-sqlite --disable-warning=ExperimentalWarning src/apiServer.js",
    "migrate": "node --experimental-sqlite --disable-warning=ExperimentalWarning scripts/migrate-from-sheets.js",
    "migrate:turso": "node scripts/migrate-to-turso.mjs",
    "backup": "node --experimental-sqlite --disable-warning=ExperimentalWarning scripts/backup.js",
    "test": "node --experimental-sqlite --disable-warning=ExperimentalWarning --test"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "googleapis": "^178.0.0",
    "pdfkit": "^0.17.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
