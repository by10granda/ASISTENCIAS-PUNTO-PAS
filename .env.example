# --- Modo recomendado en el servidor Windows: base local + API ---
DATA_BACKEND=sqlite
DATABASE_FILE=./data/asistencias.db
APP_TIME_ZONE=America/Guayaquil

# API de datos que consume Vercel a traves de Cloudflare Tunnel.
# STORE_API_TOKEN debe ser el mismo valor en el servidor y en Vercel.
STORE_API_PORT=3001
STORE_API_HOST=127.0.0.1
# STORE_API_TOKEN=generar_un_token_largo_y_aleatorio

# --- Modo Vercel: la pagina usa la API del servidor ---
# En Vercel configure:
# DATA_BACKEND=remote
# STORE_API_URL=https://api.sudominio.com
# STORE_API_TOKEN=el_mismo_token_del_servidor
# APP_USERNAME=admin
# APP_PASSWORD=UnaClaveLargaYSegura
# APP_TIME_ZONE=America/Guayaquil

# Autenticacion basica de la pagina (servidor o Vercel)
# APP_USERNAME=admin
# APP_PASSWORD=CambieEstaClaveSegura

# --- Solo necesarias si DATA_BACKEND=sheets o para ejecutar "npm run migrate" ---
GOOGLE_SHEETS_ID=ID_DEL_ARCHIVO_DE_GOOGLE_SHEETS
GOOGLE_SERVICE_ACCOUNT_EMAIL=correo-de-la-cuenta@proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPEGAR_LA_CLAVE_AQUI\n-----END PRIVATE KEY-----\n"
